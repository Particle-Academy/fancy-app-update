{
  "name": "@particle-academy/fancy-app-update",
  "version": "0.7.0",
  "description": "Framework-agnostic 'a new version is available — refresh' detector for any React app. Detect a redeploy (changed build) while the page is open and prompt a refresh. No Inertia, no PHP, no backend required — bring your own API, a version string, or just poll the page's ETag.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-app-update.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-app-update#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-app-update/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stack": {
      "import": {
        "types": "./dist/stack.d.ts",
        "default": "./dist/stack.js"
      },
      "require": {
        "types": "./dist/stack.d.cts",
        "default": "./dist/stack.cjs"
      }
    },
    "./cards": {
      "import": {
        "types": "./dist/cards.d.ts",
        "default": "./dist/cards.js"
      },
      "require": {
        "types": "./dist/cards.d.cts",
        "default": "./dist/cards.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "react",
    "version",
    "update",
    "deploy",
    "refresh",
    "new-version",
    "service-worker-alternative",
    "etag",
    "fancy",
    "particle-academy"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@particle-academy/react-fancy": ">=5.41.0 <6.0.0"
  },
  "peerDependenciesMeta": {
    "@particle-academy/react-fancy": {
      "optional": true
    }
  },
  "devDependencies": {
    "@particle-academy/react-fancy": "^5.50.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
